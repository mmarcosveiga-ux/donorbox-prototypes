    if (pop.type === "op") return sfbOpsFor(rule.field).map((o) => <MenuItem key={o} label={sfbOpLabel(rule.field, o)} checked={o === rule.op} onClick={() => pickOp(o)} />);
    if (pop.type === "more") return <>
      {SFB_FIELDS[rule.field].type !== "enum" && <MenuItem icon="branch" label="Add an “or” condition" onClick={() => open("or", rule.id, seg(rule.id, "more"), { addAlt: true })} />}
      <MenuItem icon="copy" label="Duplicate" onClick={() => { upd((n) => { const i = n.chips.findIndex((c) => c.id === rule.id); n.chips.splice(i + 1, 0, { ...JSON.parse(JSON.stringify(rule)), id: ++sfbUid }); }); close(); }} />
      <div className="sfb-sep" />
      <MenuItem icon="trash" label="Remove" danger onClick={() => removeChip(rule.id)} />
    </>;
    if (pop.type === "morefilters") return <>
      <div className="sfb-pad"><input className="sfb-in" autoFocus placeholder="Search filters" value={q} onChange={(e) => setQ(e.target.value)} aria-label="Search filters" /></div>
      <div className="sfb-list"><FieldList onPick={(k) => addChip(k, "#sfb-more-btn")} /></div>
      <div className="sfb-sep" />
      <MenuItem icon="filter" label="Advanced filter (and / or)" onClick={() => toAdvanced(null)} />
    </>;
    if (pop.type === "val") {
      const f = SFB_FIELDS[rule.field];
      if (rule.field === "frequency") return <FreqEditor key={rule.id + (pop.focusOp ? ":op" : "")} rule={rule} focusOp={!!pop.focusOp} onApply={(v) => { upd((n) => { const r = findIn(n, pop.id); r.op = v.op; r.val = v.val; r.sub = v.sub; }); close(); }} />;
      return <ValEditor key={rule.id + (pop.focusOp ? ":op" : "")} rule={rule} focusOp={!!pop.focusOp} onApply={(v) => { upd((n) => Object.assign(findIn(n, pop.id), v)); close(); }} />;
    }
    if (pop.type === "adv") {
      const A = state.adv;
      const parts = sfbSummaryParts(state);
      return <>
        <div className="sfb-adv-head"><b>Advanced filter</b><span>Each group uses one connector (and / or).<br />Groups combine with the connector between them.</span></div>
        <div className="sfb-adv-body">
          {A.groups.map((g, gi) => <React.Fragment key={gi}>
            {gi > 0 && <div className="sfb-gjoin"><select className="sfb-sel is-join" value={A.join} onChange={(e) => updAdv((a) => { a.join = e.target.value; })} aria-label="Match between groups"><option value="and">and</option><option value="or">or</option></select></div>}
            <div className="sfb-grp">
              <div className="sfb-grp-head"><span>{A.groups.length > 1 ? `Group ${gi + 1}` : "Conditions"}</span>{A.groups.length > 1 && <button className="sfb-ix" onClick={() => updAdv((a) => { a.groups.splice(gi, 1); })} aria-label="Remove group"><SfbIcon k="trash" /></button>}</div>
              {g.rules.map((r, ri) => {
                const ek = `${gi}-${ri}`;
                return <React.Fragment key={r.id}>
                  <div className="sfb-row">
                    <div className="sfb-conn">{ri === 0 ? "Where" : ri === 1
                      ? <select className="sfb-sel is-join" value={g.join} onChange={(e) => updAdv((a) => { a.groups[gi].join = e.target.value; })} aria-label="Match within group"><option value="and">and</option><option value="or">or</option></select>
                      : g.join}</div>
                    <select className="sfb-sel" value={r.field} onChange={(e) => { setEnumOpen(null); advField(gi, ri, e.target.value); }} aria-label="Field">
                      {Object.entries(SFB_FIELDS).filter(([k]) => k !== "segment").map(([k, f]) => <option key={k} value={k}>{f.label}</option>)}
                    </select>
                    <select className="sfb-sel" value={r.op || ""} onChange={(e) => advOp(gi, ri, e.target.value)} aria-label="Condition">
                      {sfbOpsFor(r.field).map((o) => <option key={o} value={o}>{sfbOpLabel(r.field, o)}</option>)}
                    </select>
                    <SfbAdvValue r={r} onChange={(patch) => updAdv((a) => Object.assign(advRule(a, gi, ri), patch))} enumOpen={enumOpen === ek} setEnumOpen={(v) => setEnumOpen(v ? ek : null)} />
                    <button className="sfb-ix" onClick={() => { setEnumOpen(null); updAdv((a) => { a.groups[gi].rules.splice(ri, 1); if (!a.groups[gi].rules.length) a.groups.splice(gi, 1); }); }} aria-label="Remove condition"><SfbIcon k="x" /></button>
                  </div>
                  {enumOpen === ek && SFB_FIELDS[r.field].type === "enum" && <div className="sfb-row" style={{ paddingTop: 0 }}><div className="sfb-enum-list">
                    {SFB_FIELDS[r.field].options.map((o) => <button key={o} type="button" className="sfb-toggle" title={SFB_FIELDS[r.field].optDesc ? SFB_FIELDS[r.field].optDesc[o] : undefined} aria-pressed={r.val.includes(o)} onClick={() => updAdv((a) => { const x = advRule(a, gi, ri); if (SFB_FIELDS[x.field].single && x.val[0] !== o) x.sub = {}; x.val = SFB_FIELDS[x.field].single ? [o] : x.val.includes(o) ? x.val.filter((y) => y !== o) : [...x.val, o]; })}>{o}</button>)}
                  </div>{r.field === "frequency" && <div className="fq-adv" style={{ gridColumn: "2 / 5" }}><FreqFields sel={(r.val || [])[0]} sub={r.sub} onSub={(patch) => updAdv((a) => { const x = advRule(a, gi, ri); x.sub = { ...(x.sub || {}), ...patch }; })} /></div>}</div>}
                </React.Fragment>;
              })}
              <div style={{ padding: "6px 0 0 82px" }}><button className="sfb-link" onClick={() => updAdv((a) => { const last = a.groups[gi].rules[a.groups[gi].rules.length - 1]; a.groups[gi].rules.push(sfbDefaultRule(last ? last.field : "donationDate")); })}>+ Add condition</button></div>
            </div>
          </React.Fragment>)}
          <div style={{ paddingTop: 12 }}><button className="sfb-link" onClick={() => updAdv((a) => { a.groups.push({ join: "and", rules: [sfbDefaultRule("donationDate")] }); })}>+ Add condition group</button></div>
        </div>
        {parts.length > 0 && <div className="sfb-summary">{parts.map((p, i) => <React.Fragment key={i}>{p.join && <b> {p.join} </b>}{p.wrap ? `(${p.text})` : p.text}</React.Fragment>)}</div>}
        <div className="sfb-adv-foot">
          <div style={{ display: "flex", gap: 16, alignItems: "center" }}>
            <button className="sfb-link is-danger" onClick={clearAll}>Delete filter</button>
            {canSimplify() && <button className="sfb-link" onClick={simplify}>Switch to simple filters</button>}
          </div>
          <div style={{ display: "flex", gap: 12, alignItems: "center" }}><span className="sfb-muted">{resultCount} {resultCount === 1 ? "supporter" : "supporters"}</span><button className="sfb-btn is-primary" onClick={close}>Done</button></div>
        </div>
      </>;
    }
    return null;
  }

  /* ── chip markup ── */
  useEffect(() => {
    if (!pop || pop.type !== "seg" || !popRef.current) return;
    const el = popRef.current.querySelector(".seg-opt.is-on") || popRef.current.querySelector(".seg-opt");
    if (el) setTimeout(() => el.focus(), 0);
  }, [pop && pop.type, pop && pop.id]);
  const isOpen = (id, t) => !!pop && pop.id === id && pop.type === t;
  const Chip = ({ r }) => {
    const f = SFB_FIELDS[r.field];
    if (r.alts && r.alts.length) {
      const label = f.type === "date" ? SFB_DATE_SHORT[r.field] || f.label : f.label, txt = sfbAltText(r);
      return (
        <div className="sfb-chip" data-sfb-seg={`${r.id}-or`}>
          <button className="sfb-x" onClick={() => removeChip(r.id)} aria-label={`Remove ${label} filter`}><SfbIcon k="xc" /></button>
          <button className="sfb-field" data-sfb-trigger aria-haspopup="dialog" aria-expanded={isOpen(r.id, "or")} onClick={() => toggle("or", r.id, seg(r.id, "or"))}><SfbIcon k={f.type === "date" ? "date" : f.type} />{label}</button>
          <button className="sfb-val sfb-or-val" data-sfb-trigger aria-haspopup="dialog" aria-expanded={isOpen(r.id, "or")} title={txt} onClick={() => toggle("or", r.id, seg(r.id, "or"))}>
            {[r, ...r.alts].filter(sfbComplete).map((x, i) => <React.Fragment key={x.id}>{i > 0 && <span className="sfb-adv-join"> or </span>}{SFB_FIELDS[x.field].type === "date" && (x.op === "is" || x.op === "between") ? sfbValText(x) : `${sfbOpLabel(x.field, x.op)} ${sfbValText(x)}`}</React.Fragment>)}
          </button>
          <button className="sfb-more" data-sfb-trigger data-sfb-seg={`${r.id}-more`} aria-label="More options" aria-expanded={isOpen(r.id, "more")} onClick={() => toggle("more", r.id, seg(r.id, "more"))}><SfbIcon k="dots" /></button>
        </div>
      );
    }
    if (r.field === "segment" && r.op === "any" && Array.isArray(r.val) && r.val.length <= 1) {
      const g = SEG_BY_NAME[r.val[0]];
      return (
        <div className={"sfb-chip" + (g ? "" : " is-incomplete")} data-sfb-seg={`${r.id}-seg`}>
          <button className="sfb-x" onClick={() => removeChip(r.id)} aria-label="Remove template filter"><SfbIcon k="xc" /></button>
          <button className="sfb-field" data-sfb-trigger aria-haspopup="listbox" aria-expanded={isOpen(r.id, "seg")} onClick={() => isOpen(r.id, "seg") ? close() : open("seg", r.id, seg(r.id, "seg"))}><SfbIcon k="segment" />Templates</button>
          <button className="sfb-val" data-sfb-trigger aria-haspopup="listbox" aria-expanded={isOpen(r.id, "seg")} title={g ? g.desc : undefined} onClick={() => isOpen(r.id, "seg") ? close() : open("seg", r.id, seg(r.id, "seg"))}>{g ? g.name : <span className="sfb-ph">Select template</span>}</button>
          <button className="sfb-more" data-sfb-trigger data-sfb-seg={`${r.id}-more`} aria-label="More options" aria-expanded={isOpen(r.id, "more")} onClick={() => toggle("more", r.id, seg(r.id, "more"))}><SfbIcon k="dots" /></button>
        </div>
      );
    }
    if (f.type === "date") {
      const done = sfbComplete(r), txt = sfbValText(r);
      return (
        <div className={"sfb-chip" + (done ? "" : " is-incomplete")} data-sfb-seg={`${r.id}-drf`}>
          <button className="sfb-x" onClick={() => removeChip(r.id)} aria-label={`Remove ${SFB_DATE_SHORT[r.field]} filter`}><SfbIcon k="xc" /></button>
          <button className="sfb-field" data-sfb-trigger aria-haspopup="dialog" aria-expanded={isOpen(r.id, "drf")} onClick={() => isOpen(r.id, "drf") ? close() : openDrf(r, seg(r.id, "drf"))}><SfbIcon k="date" />{SFB_DATE_SHORT[r.field]}</button>
          <button className="sfb-op" data-sfb-trigger data-sfb-seg={`${r.id}-op`} aria-haspopup="menu" aria-expanded={isOpen(r.id, "op")} onClick={() => toggle("op", r.id, seg(r.id, "op"))}>{sfbOpLabel(r.field, r.op || "is")}</button>
          <button className="sfb-val" data-sfb-trigger aria-haspopup="dialog" aria-expanded={isOpen(r.id, "drf")} onClick={() => isOpen(r.id, "drf") ? close() : openDrf(r, seg(r.id, "drf"))}>{done ? txt : <span className="sfb-ph">Select dates</span>}</button>
          <button className="sfb-more" data-sfb-trigger data-sfb-seg={`${r.id}-more`} aria-label="More options" aria-expanded={isOpen(r.id, "more")} onClick={() => toggle("more", r.id, seg(r.id, "more"))}><SfbIcon k="dots" /></button>
        </div>
      );
    }
    return (
      <div className={"sfb-chip" + (sfbComplete(r) ? "" : " is-incomplete")}>
        <button className="sfb-x" onClick={() => removeChip(r.id)} aria-label={`Remove ${f.label} filter`}><SfbIcon k="xc" /></button>
        <button className="sfb-field" data-sfb-trigger data-sfb-seg={`${r.id}-field`} aria-expanded={isOpen(r.id, "field")} onClick={() => toggle("field", r.id, seg(r.id, "field"))}><SfbIcon k={f.type} />{f.label}</button>
        <button className="sfb-op" data-sfb-trigger data-sfb-seg={`${r.id}-op`} aria-haspopup="menu" aria-expanded={isOpen(r.id, "op")} onClick={() => toggle("op", r.id, seg(r.id, "op"))}>{sfbOpLabel(r.field, r.op || sfbDefaultOp(r.field))}</button>
        <button className="sfb-val" data-sfb-trigger data-sfb-seg={`${r.id}-val`} aria-expanded={isOpen(r.id, "val")} onClick={() => toggle("val", r.id, seg(r.id, "val"))}>{sfbValText(r) || <span className="sfb-ph">Select value</span>}</button>
        <button className="sfb-more" data-sfb-trigger data-sfb-seg={`${r.id}-more`} aria-label="More options" aria-expanded={isOpen(r.id, "more")} onClick={() => toggle("more", r.id, seg(r.id, "more"))}><SfbIcon k="dots" /></button>
      </div>
    );
  };

  const used = new Set(state.chips.map((c) => sfbSlot(c.field)));
  const hasAny = state.mode === "advanced" || state.chips.length > 0 || !!searchActive;
  return (
    <div className="sfb-bar" aria-label="Filters">
      {lead}
      {state.mode === "simple" ? <>
        {/* quick fields keep their slot (Donation date first); an active chip replaces its dashed "+" chip in place */}
        {SFB_QUICK.map((f) => used.has(f)
          ? state.chips.filter((r) => sfbSlot(r.field) === f).map((r) => <Chip key={r.id} r={r} />)
          : <button key={f} className="sfb-quick" data-sfb-trigger={sfbIsDate(f) || f === "segment" || f === "campaign" ? "" : undefined} data-sfb-quick={f} aria-expanded={sfbIsDate(f) ? (!!pop && pop.type === "drf" && !pop.id) : f === "segment" ? (!!pop && pop.type === "seg" && !pop.id) : f === "campaign" ? (!!pop && pop.type === "camp" && !pop.id) : undefined} onClick={() => (sfbIsDate(f) && pop && pop.type === "drf" && !pop.id) || (f === "segment" && pop && pop.type === "seg" && !pop.id) || (f === "campaign" && pop && pop.type === "camp" && !pop.id) ? close() : addChip(f)}><SfbIcon k="plusc" />{SFB_FIELDS[f].label}</button>)}
        {state.chips.filter((r) => !SFB_QUICK.includes(sfbSlot(r.field))).map((r) => <Chip key={r.id} r={r} />)}
        <button id="sfb-more-btn" className="sfb-quick" data-sfb-trigger aria-expanded={!!pop && pop.type === "morefilters"} onClick={() => toggle("morefilters", null, "#sfb-more-btn")}><SfbIcon k="plusc" />More filters</button>
      </> : (
        <div className="sfb-chip" id="sfb-adv-chip">
          <button className="sfb-x" onClick={clearAll} aria-label="Remove advanced filter"><SfbIcon k="xc" /></button>
          <button className="sfb-field" data-sfb-trigger aria-expanded={!!pop && pop.type === "adv"} onClick={() => toggle("adv", null, "#sfb-adv-chip")} aria-label={`Advanced filter: ${sfbAdvSummary(state).text || "no conditions yet"}`} title={sfbAdvSummary(state).text || undefined}><SfbIcon k="filter" /><span className="sfb-adv-sum">{sfbAdvSummary(state).nodes.length ? sfbAdvSummary(state).nodes : <span className="sfb-ph">Advanced filter · no conditions yet</span>}</span></button>
        </div>
      )}
      {hasAny && <button className="sfb-link" onClick={() => { clearAll(); onClearSearch && onClearSearch(); }}>Clear all</button>}
      {trail}
      {pop && ReactDOM.createPortal(
        <div ref={popRef} className={"sfb-pop" + (pop.type === "or" ? " is-or" : pop.type === "adv" ? " is-adv" : pop.type === "drf" ? " is-drf" : (pop.type === "val" && rule && rule.field !== "frequency" && rule.field !== "campaign") ? " is-vx" : pop.type === "seg" ? " is-seg" : (pop.type === "val" && rule && rule.field === "frequency") ? " is-freq" : (pop.type === "camp" || (pop.type === "val" && rule && rule.field === "campaign")) ? " is-camp" : "")} role="dialog" style={{ top: pos ? pos.top : -9999, left: pos ? pos.left : -9999 }}>{body()}</div>,
        document.body
      )}
    </div>
  );
}

/* ═══ SAVED LISTS ═══ */
const sfbKey = (st, search) => JSON.stringify({ j: sfbLogic(st).join, g: sfbLive(st).map((g) => ({ j: g.join, r: g.rules.map((r) => [r.field, r.op, r.val, r.val2]) })), q: search || "" });
const sfbHasMovingDates = (st) => sfbLive(st).some((g) => g.rules.some((r) => SFB_FIELDS[r.field].type === "date" && ((r.op === "is" || r.op === "isnot") && sfbPeriod(r.val) || ((r.op === "before" || r.op === "after") && ["today", "30d", "12m"].includes(r.val)))));
const listState = (rules) => ({ mode: "simple", chips: rules, adv: null });
const SEED_LISTS = (() => {
  const gala = listState([sfbNewRule("campaign", "any", ["Annual Gala 2026"])]);
  return [
    { id: "l1", name: "No gift in the last 30 days", desc: "Most recent gift was more than 30 days ago", type: "dynamic", state: listState([sfbNewRule("lastDonation", "before", "30d")]), search: "" },
    { id: "l2", name: "Long-time supporters", desc: "First gift on or before Dec 31, 2023", type: "dynamic", state: listState([sfbNewRule("firstDonation", "between", "", "2023-12-31")]), search: "" },
    { id: "l3", name: "Annual Gala invitees", desc: "Snapshot taken for the invitation mailing", type: "static", state: gala, search: "", members: SUPPORTERS.filter((x) => sfbMatch(gala, x)).map((x) => x.id) },
  ];
})();
const listCount = (l) => l.type === "static" ? l.members.length : SUPPORTERS.filter((x) => sfbMatch(l.state, x)).length;

function SavedListsMenu({ lists, active, onPick }) {
  const [open, setOpen] = useState(false);
  const ref = useRef(null);
  useEffect(() => {
    if (!open) return;
    const h = (e) => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); };
    const k = (e) => { if (e.key === "Escape") setOpen(false); };
    document.addEventListener("mousedown", h); document.addEventListener("keydown", k);
    return () => { document.removeEventListener("mousedown", h); document.removeEventListener("keydown", k); };
  }, [open]);
  return (
    <div ref={ref} style={{ position: "relative" }}>
      <button type="button" className={"sl-trigger" + (active ? " is-active" : "")} aria-haspopup="listbox" aria-expanded={open} onClick={() => setOpen((v) => !v)}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11" /><path d="M4 6h.01M4 12h.01M4 18h.01" /></svg>
        <span style={{ maxWidth: 220, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{active ? active.name : "Saved lists"}</span>
        <svg width="12" height="12" viewBox="0 0 20 20" fill="none" aria-hidden="true" style={{ transform: open ? "rotate(180deg)" : "none", transition: "transform .2s" }}><path d="M15.8333 7.5L10 13.3333L4.16667 7.5" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" /></svg>
      </button>
      {open && (
        <div className="sl-menu" role="listbox" aria-label="Saved lists">
          <button type="button" role="option" aria-selected={!active} className="sl-opt" onClick={() => { onPick(null); setOpen(false); }}>
            <span className="sl-name">All supporters</span><span className="sl-meta">{SUPPORTERS.length}</span>
          </button>
          <div className="sl-sep" />
          <div className="sl-label">Saved lists</div>
          {lists.map((l) => (
            <button key={l.id} type="button" role="option" aria-selected={active && active.id === l.id} className="sl-opt" onClick={() => { onPick(l); setOpen(false); }}>
              <span style={{ display: "flex", flexDirection: "column", minWidth: 0, flex: 1 }}>
                <span className="sl-name">{l.name}</span>
                {l.desc && <span className="sl-desc">{l.desc}</span>}
              </span>
              <span className={"sl-badge" + (l.type === "static" ? " is-static" : "")}>{l.type === "static" ? "Static" : "Dynamic"}</span>
              <span className="sl-meta">{listCount(l)}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

