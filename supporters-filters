<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Global Header — Donation Date Panel v5</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif; overflow: hidden; }
  #root { width: 100vw; height: 100vh; }
  input, select, button, textarea { font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; }
  input::placeholder { font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif; color: #6B7280; }
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  input[type="number"] { -moz-appearance: textfield; }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #9CA3AF; }

  .gh-search::placeholder { color:#6B7280; opacity:1; }
  .gh-search::-webkit-search-cancel-button { -webkit-appearance:none; }
  .ph-actions .dbox-df__compare-btn { height:40px; padding:8px 24px; gap:8px; font-size:16px; line-height:24px; box-sizing:border-box; }
  .gh-menu::-webkit-scrollbar { width:16px; }
  .gh-menu::-webkit-scrollbar-track { background:transparent; margin:10px 0; }
  .gh-menu::-webkit-scrollbar-thumb { background:rgba(102,102,102,0.4); border-radius:100px; border:4px solid transparent; background-clip:padding-box; }
  .gh-menu { scrollbar-width:thin; scrollbar-color:rgba(102,102,102,0.4) transparent; }
  .nav2-item:not([data-active]):hover { background: rgba(255,255,255,0.06) !important; }
  .nav2-item:focus-visible { outline:2px solid #128AED; outline-offset:-2px; }
  :root { --border-active: #128AED; }
  .gh-focus:focus-visible { outline:2px solid #128AED; outline-offset:1px; }
  .gh-opt:not([aria-selected="true"]):hover { background:#F3F4F6 !important; }
  /* ── Donorbox Date Filter DS tokens ── */
  :root {
    --dbox-primary:#056BBF;--dbox-accent:#128AED;--dbox-accent-hover:#056BBF;--dbox-accent-pressed:#1658B5;
    --dbox-bg-default:#FAFAFA;--dbox-bg-surface:#FFF;--dbox-bg-neutral:#F3F4F6;--dbox-bg-accent-hover:#EBF4FF;--dbox-bg-accent-pressed:#C2DEFF;
    --dbox-border-default:#D1D5DB;--dbox-border-subtle:#E5E7EB;--dbox-border-hover:#1F2A37;--dbox-border-accent:#128AED;
    --dbox-text-default:#111928;--dbox-text-secondary:#1F2A37;--dbox-text-tertiary:#6B7280;--dbox-text-disabled:#D1D5DB;--dbox-text-inverse:#FFF;--dbox-text-accent:#128AED;
    --dbox-success-subtle:#DEF7EC;--dbox-success-strong:#046C4E;--dbox-success-border:#BCF0DA;
    --dbox-warning-subtle:#FDF6B2;--dbox-warning-strong:#8E4B10;--dbox-warning-border:#FCE96A;
    --dbox-space-1:8px;--dbox-space-1-5:12px;--dbox-space-2:16px;--dbox-space-3:24px;
    --dbox-radius-sm:4px;--dbox-radius-md:6px;--dbox-radius-lg:8px;--dbox-radius-xl:10px;--dbox-radius-2xl:12px;--dbox-radius-full:9999px;
    --dbox-font:Inter,sans-serif;--dbox-font-size-xs:12px;--dbox-font-size-sm:14px;
    --dbox-font-weight-regular:400;--dbox-font-weight-medium:500;--dbox-font-weight-semibold:600;
    --dbox-line-height-xs:16px;--dbox-line-height-sm:20px;
    --dbox-shadow-md:0 4px 6px -1px rgba(0,0,0,0.1),0 2px 4px -2px rgba(0,0,0,0.05);
  }
  .dbox-df { font-family:var(--dbox-font); }
  .dbox-df__row { display:flex;align-items:center;gap:var(--dbox-space-1);flex-wrap:wrap;position:relative; }
  .dbox-df__group { display:inline-flex;align-items:center;flex-shrink:0;position:relative;isolation:isolate; }
  .dbox-df__btn { height:32px;padding:0 var(--dbox-space-1-5);background:var(--dbox-bg-surface);font-family:var(--dbox-font);font-size:var(--dbox-font-size-sm);font-weight:var(--dbox-font-weight-medium);line-height:var(--dbox-line-height-sm);color:var(--dbox-text-secondary);cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:var(--dbox-space-1);user-select:none;position:relative;border:1px solid var(--dbox-border-default);border-radius:0;margin-left:-1px; }
  .dbox-df__btn:not(.is-active):hover { background:var(--dbox-bg-neutral); }
  .dbox-df__btn:first-child { margin-left:0;border-radius:var(--dbox-radius-sm) 0 0 var(--dbox-radius-sm); }
  .dbox-df__btn:last-child { border-radius:0 var(--dbox-radius-sm) var(--dbox-radius-sm) 0; }
  .dbox-df__btn.is-active { background:#C2DEFF;color:#1658B5;font-weight:var(--dbox-font-weight-medium);border:1px solid var(--dbox-border-accent)!important;border-radius:0;z-index:3;position:relative; }
  .dbox-df__btn:first-child.is-active { border-radius:var(--dbox-radius-sm) 0 0 var(--dbox-radius-sm); }
  .dbox-df__btn:last-child.is-active { border-radius:0 var(--dbox-radius-sm) var(--dbox-radius-sm) 0; }
  .dbox-df__btn:only-child.is-active { border-radius:var(--dbox-radius-sm); }
  .dbox-df__compare-btn { height:40px;padding:0 var(--dbox-space-1-5);border:1px solid var(--dbox-border-default);border-radius:var(--dbox-radius-sm);background:var(--dbox-bg-surface);font-family:var(--dbox-font);font-size:var(--dbox-font-size-sm);font-weight:var(--dbox-font-weight-medium);line-height:var(--dbox-line-height-sm);color:var(--dbox-text-secondary);cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px;user-select:none;flex-shrink:0; }
  .dbox-df__compare-btn:hover { background:var(--dbox-bg-neutral); }
  .dbox-df__compare-btn .lbl { color:var(--dbox-text-secondary);font-weight:var(--dbox-font-weight-medium); }
  .dbox-df__compare-btn .val { font-weight:var(--dbox-font-weight-medium);color:var(--dbox-text-secondary); }
  .dbox-df__popover { display:none;position:absolute;top:calc(100% + 6px);left:0;background:var(--dbox-bg-surface);border:1px solid var(--dbox-border-subtle);border-radius:var(--dbox-radius-2xl);width:523px;z-index:100;flex-direction:column;box-shadow:var(--dbox-shadow-md); }
  .dbox-df__popover.is-open { display:flex; }
  .dbox-df__popover--right { left:auto;right:0; }
  .dbox-df__pop-body { display:flex;gap:24px;padding:16px 24px; }
  .dbox-df__pop-left { width:164px;flex-shrink:0;display:flex;flex-direction:column;gap:0; }
  .dbox-df__pop-divider { width:1px;background:var(--dbox-border-subtle);flex-shrink:0;align-self:stretch; }
  .dbox-df__pop-right { width:224px;flex-shrink:0;display:flex;flex-direction:column;gap:16px;padding-top:12px;padding-bottom:0; }
  .dbox-df__pop-hint { font-size:var(--dbox-font-size-sm);color:var(--dbox-text-secondary);line-height:var(--dbox-line-height-sm);padding-top:var(--dbox-space-1); }
  .dbox-df__radio-row { display:flex;align-items:center;gap:8px;height:40px;padding:8px 0;cursor:pointer;user-select:none;border-radius:var(--dbox-radius-md); }
  .dbox-df__radio-row:hover { background:var(--dbox-bg-neutral); }
  .dbox-df__radio-outer { width:20px;height:20px;border-radius:var(--dbox-radius-full);border:2px solid var(--dbox-border-default);flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--dbox-bg-surface); }
  .dbox-df__radio-row.is-selected .dbox-df__radio-outer { background:var(--dbox-accent);border-color:var(--dbox-accent); }
  .dbox-df__radio-dot { width:8px;height:8px;border-radius:var(--dbox-radius-full);background:var(--dbox-bg-surface);display:none; }
  .dbox-df__radio-row.is-selected .dbox-df__radio-dot { display:block; }
  .dbox-df__radio-label { font-size:var(--dbox-font-size-sm);font-weight:var(--dbox-font-weight-medium);color:var(--dbox-text-default);line-height:var(--dbox-line-height-sm); }
  .dbox-df__field { display:flex;flex-direction:column;gap:var(--dbox-space-1); }
  .dbox-df__label { font-size:var(--dbox-font-size-xs);font-weight:var(--dbox-font-weight-medium);color:var(--dbox-text-secondary);line-height:var(--dbox-line-height-xs); }
  .dbox-df__input { width:100%;height:40px;padding:8px 12px;border:1px solid var(--dbox-border-default);border-radius:8px;background:var(--dbox-bg-default);font-family:var(--dbox-font);font-size:var(--dbox-font-size-sm);color:var(--dbox-text-default);box-sizing:border-box; }
  .dbox-df__input:focus { outline:none;border-color:var(--dbox-border-accent);background:var(--dbox-bg-surface); }
  .dbox-df__input::placeholder { color:var(--dbox-text-disabled); }
  .dbox-df__input:disabled { background:var(--dbox-bg-neutral);color:var(--dbox-text-tertiary);cursor:not-allowed; }
  .dbox-df__footer { display:flex;align-items:center;justify-content:space-between;padding:16px;border-top:1px solid var(--dbox-border-subtle); }
  .dbox-df__btn-tertiary { height:32px;padding:0 var(--dbox-space-2);background:transparent;border:none;border-radius:var(--dbox-radius-sm);font-family:var(--dbox-font);font-size:var(--dbox-font-size-sm);font-weight:var(--dbox-font-weight-medium);color:var(--dbox-text-secondary);cursor:pointer; }
  .dbox-df__btn-tertiary:hover { background:var(--dbox-bg-neutral); }
  .dbox-df__btn-primary { height:32px;padding:0 var(--dbox-space-2);background:var(--dbox-accent);border:none;border-radius:var(--dbox-radius-sm);font-family:var(--dbox-font);font-size:var(--dbox-font-size-sm);font-weight:var(--dbox-font-weight-medium);color:var(--dbox-text-inverse);cursor:pointer; }
  .dbox-df__btn-primary:hover { background:var(--dbox-accent-hover); }
  .dbox-df__btn-primary:disabled { background:var(--dbox-text-disabled);cursor:not-allowed; }
  
  .dbox-df__total-range { display:none;align-items:center;gap:4px; }
  .dbox-df__total-range.is-visible { display:flex; }
  .dbox-df__total-range-badge { display:inline-flex;align-items:center;justify-content:center;height:20px;padding:0 8px;background:#F3F4F6;border-radius:4px;font-family:var(--dbox-font);font-size:12px;color:#111928;white-space:nowrap; }
  .dbox-df__total-range-badge b { font-weight:600;margin-right:2px; }
  .dbox-df__chip-row { min-height:26px; }
  .dbox-df__chip { display:inline-flex;align-items:center;gap:5px;padding:4px var(--dbox-space-1-5);border-radius:var(--dbox-radius-lg);background:var(--dbox-bg-neutral);border:1px solid var(--dbox-border-subtle);font-size:12px;color:var(--dbox-text-secondary); }
  .dbox-df__chip-dot { width:4px;height:4px;border-radius:var(--dbox-radius-full);background:var(--dbox-border-default);flex-shrink:0; }
  .dbox-df__chip-bold { font-weight:var(--dbox-font-weight-semibold);color:var(--dbox-text-default); }
  .dbox-df__chip-vs { font-size:11px;color:var(--dbox-text-tertiary); }
  .dbox-df__chip-prev { color:var(--dbox-text-tertiary); }
  .dbox-df__tag { font-size:11px;font-weight:var(--dbox-font-weight-medium);padding:2px var(--dbox-space-1);border-radius:var(--dbox-radius-full); }
  .dbox-df__tag--any { background:var(--dbox-bg-neutral);color:var(--dbox-text-secondary);border:1px solid var(--dbox-border-default); }
  .dbox-df__tag--first { background:var(--dbox-success-subtle);color:var(--dbox-success-strong);border:1px solid var(--dbox-success-border); }
  .dbox-df__tag--last { background:var(--dbox-bg-accent-hover);color:var(--dbox-primary);border:1px solid var(--dbox-bg-accent-pressed); }
  .dbox-df__tag--alltime { background:var(--dbox-warning-subtle);color:var(--dbox-warning-strong);border:1px solid var(--dbox-warning-border); }
  /* ── Button tooltips ── */
  [data-tooltip] { position: relative; }
  [data-tooltip]::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%); background: #111928; color: #FFF; font-family: Inter, sans-serif; font-size: 12px; font-weight: 500; line-height: 16px; white-space: pre; max-width: 220px; text-align: center; padding: 6px 10px; border-radius: 6px; pointer-events: none; opacity: 0; transition: opacity 0.15s ease; z-index: 200; }
  [data-tooltip]:hover::after { opacity: 1; }

  .dbox-plans-badge { display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: var(--sm, 4px); border: 1px solid transparent; background: #F3F4F6; color: #6B7280; font-size: 12px; font-weight: 500; transition: background-color 0.15s ease, border-color 0.15s ease; }
  .dbox-plans-badge:hover { border-radius: var(--sm, 4px); border: 1px solid var(--border-accent, #128AED); background: var(--background-neutral-hover, #ECEFF4); }

  /* ── Donation Date Range Filter (new dropdown) ── */
    /* ── Design Tokens ─────────────────────────────────────────── */
    :root {
      --dbox-color-background-default: #FAFAFA;
      --dbox-color-background-surface: #FFFFFF;
      --dbox-color-background-neutral: #F3F4F6;
      --dbox-color-background-accent-subtle: #E0EEFF;
      --dbox-color-background-accent-primary: #128AED;
      --dbox-color-background-accent-disabled: #D1D5DB;
      --dbox-color-background-secondary-hover: #EBF4FF;
      --dbox-color-text-default: #111928;
      --dbox-color-text-secondary: #1F2A37;
      --dbox-color-text-tertiary: #6B7280;
      --dbox-color-text-inverse: #FFFFFF;
      --dbox-color-border-default: #D1D5DB;
      --dbox-color-border-subtle: #E5E7EB;
      --dbox-color-border-accent: #128AED;
      --dbox-border-radius-sm: 4px;
      --dbox-border-radius-md: 8px;
      --dbox-spacing-xs: 4px;
      --dbox-spacing-sm: 8px;
      --dbox-spacing-md: 12px;
      --dbox-spacing-lg: 16px;
      --dbox-spacing-2xl: 24px;
      --dbox-font-size-xs: 12px;
      --dbox-font-size-sm: 14px;
      --dbox-font-weight-medium: 500;
      --dbox-font-weight-semibold: 600;
      --dbox-line-height-xs: 16px;
      --dbox-line-height-sm: 20px;
    }
    /* ── Component ─────────────────────────────────────────────── */
    .dbox-date-range-filter {
      display: flex;
      flex-direction: column;
      background-color: var(--dbox-color-background-surface);
      border: 1px solid var(--dbox-color-border-subtle);
      border-radius: var(--dbox-border-radius-md);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,.10), 0 2px 4px -2px rgba(0,0,0,.05);
      overflow: hidden;
    }

    .dbox-date-range-filter__body {
      display: flex;
      gap: var(--dbox-spacing-2xl);
      padding: var(--dbox-spacing-lg) var(--dbox-spacing-2xl);
    }

    /* Left — donation types */
    .dbox-date-range-filter__donation-types {
      display: flex;
      flex-direction: column;
      gap: var(--dbox-spacing-sm);
      width: 192px;
      flex-shrink: 0;
    }

    .dbox-date-range-filter__option {
      display: flex;
      gap: var(--dbox-spacing-sm);
      align-items: flex-start;
      min-height: 40px;
      padding: var(--dbox-spacing-sm) 0;
      cursor: pointer;
    }

    .dbox-date-range-filter__option > input[type="radio"] {
      appearance: none;
      -webkit-appearance: none;
      width: 20px;
      height: 20px;
      border: 1px solid var(--dbox-color-border-default);
      border-radius: 50%;
      background-color: var(--dbox-color-background-surface);
      position: relative;
      flex-shrink: 0;
      margin-top: 2px;
      cursor: pointer;
      transition: border-color .1s, background-color .1s;
    }

    .dbox-date-range-filter__option > input[type="radio"]:checked {
      background-color: var(--dbox-color-background-accent-primary);
      border-color: var(--dbox-color-border-accent);
    }

    .dbox-date-range-filter__option > input[type="radio"]:checked::after {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 8px; height: 8px;
      background-color: var(--dbox-color-background-surface);
      border-radius: 50%;
    }

    .dbox-date-range-filter__option-info { display: flex; flex-direction: column; min-width: 0; }

    .dbox-date-range-filter__option-title {
      font-size: var(--dbox-font-size-sm);
      font-weight: var(--dbox-font-weight-medium);
      color: var(--dbox-color-text-default);
      line-height: var(--dbox-line-height-sm);
    }

    .dbox-date-range-filter__option-desc {
      font-size: var(--dbox-font-size-xs);
      font-weight: var(--dbox-font-weight-medium);
      color: var(--dbox-color-text-tertiary);
      line-height: var(--dbox-line-height-xs);
    }

    /* Divider */
    .dbox-date-range-filter__divider {
      width: 1px;
      align-self: stretch;
      background-color: var(--dbox-color-border-subtle);
      flex-shrink: 0;
    }

    /* Right — date section */
    .dbox-date-range-filter__date-section {
      display: flex;
      flex-direction: column;
      gap: var(--dbox-spacing-lg);
      padding-top: var(--dbox-spacing-md);
      width: 329px;
    }

    .dbox-date-range-filter__timeframe {
      display: flex;
      flex-direction: column;
      gap: var(--dbox-spacing-sm);
    }

    .dbox-date-range-filter__section-label {
      font-size: var(--dbox-font-size-xs);
      font-weight: var(--dbox-font-weight-medium);
      color: var(--dbox-color-text-secondary);
      line-height: var(--dbox-line-height-xs);
    }

    .dbox-date-range-filter__chips {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--dbox-spacing-xs);
    }

    /* Row 1: natural width — 12px padding always respected, all 6 fit in one row */
    .dbox-date-range-filter__chips--row1 > .dbox-date-range-filter__chip { flex-shrink: 0; }

    /* Row 2: 12M/MTD/QTD/YTD stretch equally; "Last year" keeps natural width */
    .dbox-date-range-filter__chips--row2 > .dbox-date-range-filter__chip { flex: 1 0 0; min-width: 0; }
    .dbox-date-range-filter__chips--row2 > .dbox-date-range-filter__chip:last-child { flex: 0 0 auto; }

    .dbox-date-range-filter__chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 32px;
      padding: 4px var(--dbox-spacing-md); /* 12px left/right minimum */
      background-color: var(--dbox-color-background-surface);
      border: 1px solid var(--dbox-color-border-default);
      border-radius: 9999px;
      font-size: var(--dbox-font-size-xs);
      font-weight: var(--dbox-font-weight-medium);
      font-family: inherit;
      color: var(--dbox-color-text-default);
      white-space: nowrap;
      overflow: hidden;
      cursor: pointer;
      transition: background-color .1s, border-color .1s;
    }

    .dbox-date-range-filter__chip:hover { background-color: var(--dbox-color-background-secondary-hover); }
    .dbox-date-range-filter__chip[aria-pressed="true"] {
      background-color: var(--dbox-color-background-accent-subtle);
      border-color: var(--dbox-color-border-accent);
    }
    .dbox-date-range-filter__chip:focus-visible {
      outline: 2px solid var(--dbox-color-border-accent);
      outline-offset: 2px;
    }

    /* Text inputs */
    .dbox-text-field { display: flex; flex-direction: column; gap: var(--dbox-spacing-sm); width: 100%; }

    .dbox-text-field > label {
      font-size: var(--dbox-font-size-xs);
      font-weight: var(--dbox-font-weight-medium);
      color: var(--dbox-color-text-secondary);
      line-height: var(--dbox-line-height-xs);
    }

    .dbox-text-field > input[type="date"] {
      width: 100%;
      height: 40px;
      padding: 0 var(--dbox-spacing-md);
      font-size: var(--dbox-font-size-sm);
      font-weight: var(--dbox-font-weight-medium);
      font-family: inherit;
      color: var(--dbox-color-text-default);
      background-color: var(--dbox-color-background-default);
      border: 1px solid var(--dbox-color-border-default);
      border-radius: var(--dbox-border-radius-sm);
      outline: none;
      transition: border-color .1s;
    }
    .dbox-text-field > input[type="date"]:focus { border-color: var(--dbox-color-border-accent); }
    .dbox-text-field > input[type="date"]::-webkit-datetime-edit { color: var(--dbox-color-text-tertiary); }
    .dbox-text-field > input[type="date"]:not(:placeholder-shown)::-webkit-datetime-edit { color: var(--dbox-color-text-default); }

    /* Total Range badge */
    .dbox-date-range-filter__total-range { display: flex; }

    .dbox-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      height: 20px;
      padding: 0 var(--dbox-spacing-sm);
      border-radius: var(--dbox-border-radius-sm);
      font-size: var(--dbox-font-size-xs);
      font-weight: var(--dbox-font-weight-medium);
      color: var(--dbox-color-text-default);
      background-color: var(--dbox-color-background-neutral);
    }

    /* Footer */
    .dbox-date-range-filter__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--dbox-spacing-lg);
      border-top: 1px solid var(--dbox-color-border-subtle);
    }

    /* Buttons */
    .dbox-button {
